// Debug.xcconfig — Flutter-generated config + FRF engine link.
//
// The Rust engine is statically linked into the Runner binary so the Dart
// FFI layer can find its symbols via DynamicLibrary.process(). The engine
// archive is produced by scripts/build_ios_engine.sh (or the CI iOS job)
// into Engine/librecovery_core_ffi.a — see that script + docs/PERMISSIONS.
//
// -force_load is REQUIRED: nothing in the app references the engine's C
// symbols directly (dart:ffi looks them up at runtime), and a plain link
// of a static archive would strip every object as "unused".

#include "Generated.xcconfig"
OTHER_LDFLAGS = $(inherited) -force_load "$(SRCROOT)/Engine/librecovery_core_ffi.a" -Wl,-exported_symbols_list,"$(SRCROOT)/Engine/frf_exported_symbols.txt"
// The export list is REQUIRED as well: Release builds dead-strip
// unreferenced code even inside -force_load'd archives, and the Dart FFI
// resolves every frf_* symbol only at RUNTIME (DynamicLibrary.process()).
