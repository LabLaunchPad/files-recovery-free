<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Permission pack (research-verified, docs/PERMISSIONS.md):
	  - The App Sandbox entitlement is deliberately ABSENT: sandboxed builds
	    cannot read raw volumes or arbitrary files. Mac App Store is out of
	    scope for this product; distribution is notarized DMG + Homebrew cask.
	  - The network-server entitlement is deliberately ABSENT: the app is
	    offline-first (no telemetry, no uploads) — keep the trust claim true.
	-->
</dict>
</plist>
